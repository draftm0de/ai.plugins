{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "plugin-manager",
  "description": "Manage skill plugins: structure, documentation, validation and approval-gated publication.",
  "author": {
    "name": "Peter Fux",
    "url": "https://draftmode.io"
  },
  "homepage": "https://draftmode.io",
  "repository": "https://github.com/draftm0de/ai.plugins",
  "keywords": [
    "skills",
    "plugins",
    "documentation",
    "publishing"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/plugin-manager/SKILL.md",
      "interface": {
        "displayName": "Plugin Manager",
        "shortDescription": "Manage and publish skill plugins",
        "developerName": "draftmode",
        "category": "Productivity",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "websiteURL": "https://draftmode.io",
        "defaultPrompt": [
          "Document a local skill repository",
          "Verify a plugin repository",
          "Prepare a plugin publication for my approval"
        ]
      }
    },
    "io.zyris.distribution": {
      "skillRoot": "skills",
      "files": {
        "README.md": "skills/plugin-manager/templates/package/README.md",
        "README.en.md": "skills/plugin-manager/templates/package/README.en.md",
        "skills/plugin-manager/assets/icon.png": "assets/icon.png"
      },
      "catalogs": false
    }
  },
  "license": "MIT"
}
